PORT=3000
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Webhook Secret (Set up in Razorpay Dashboard -> Webhooks -> Add Webhook)
# URL: https://your-domain.com/api/razorpay-webhook | Events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# PayU India Payment Gateway (Test Sandbox or Production)
# Get credentials at: https://merchants.payu.in/ -> Toggle Test Mode -> Payment Gateway -> Key Salt Details
PAYU_MERCHANT_KEY=gtKFFx
PAYU_MERCHANT_SALT=eCwWELxi
PAYU_ENV=test

ADMIN_USERNAME=eesaadmin
ADMIN_PASSWORD=change_this_password
SESSION_SECRET=change_this_session_secret
REGISTRATION_FEE_PAISE=200
ADMIN_PATH=/eesa-portal-2026

# Persistent Database Path on Render (CRITICAL: Render filesystem is ephemeral)
# In Render Dashboard: Disks -> Add Disk -> Size 1GB -> Mount Path /var/data
# Then set DB_PATH=/var/data/eesa.db in Environment Variables.
# Leave blank for local development (defaults to ./eesa.db in project root)
DB_PATH=

