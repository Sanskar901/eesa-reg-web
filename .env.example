PORT=3000

# PayU India Payment Gateway (Set PAYU_ENV=prod for Live Production)
# Get Live credentials at: https://merchants.payu.in/ -> Payment Gateway -> Key Salt Details
PAYU_MERCHANT_KEY=your_live_payu_merchant_key
PAYU_MERCHANT_SALT=your_live_payu_merchant_salt
PAYU_ENV=prod
# Optional: Set base domain for HTTPS callbacks on production (e.g. https://yourdomain.com)
# BASE_URL=https://yourdomain.com

ADMIN_USERNAME=eesaadmin
ADMIN_PASSWORD=change_this_password
SESSION_SECRET=change_this_session_secret
REGISTRATION_FEE_PAISE=200
ADMIN_PATH=/eesa-portal-2026

# Persistent Database Path on Render (CRITICAL: Render filesystem is ephemeral)
# In Render Dashboard: Disks -> Add Disk -> Size 1GB -> Mount Path /var/data
# Then set DB_PATH=/var/data/eesa.db in Environment Variables.
# Leave blank for local development (defaults to ./eesa.db in project root)
DB_PATH=

